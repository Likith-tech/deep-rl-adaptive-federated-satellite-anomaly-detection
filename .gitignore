# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ---- Node / Frontend ----
node_modules/
frontend/dist/
frontend/build/
.vite/
*.local
*.tsbuildinfo

# ---- Environment / Secrets ----
.env
.env.*
!.env.example

# ---- Data & Models (never commit large/generated artifacts) ----
data/raw/*
data/interim/*
data/processed/*
data/partitions/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/partitions/.gitkeep
!data/README.md

results/metrics/*
results/models/*
results/plots/*
results/logs/*
results/reports/*
!results/**/.gitkeep

# Phase 1 dataset analysis deliverables — small, reviewable, worth keeping
# in the repo (unlike bulky experiment logs/metrics/model checkpoints).
!results/plots/dataset/
!results/plots/dataset/*.png
!results/reports/dataset_quality.md

*.ckpt
*.pt
*.pth
*.h5
*.onnx
*.pkl
*.pickle
*.joblib

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/
.claude/

# ---- Logs ----
*.log

# ---- Docker ----
*.pid
