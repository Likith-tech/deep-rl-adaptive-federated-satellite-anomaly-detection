# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ---- Node / Frontend ----
node_modules/
frontend/dist/
frontend/build/
.vite/
*.local
*.tsbuildinfo

# ---- Environment / Secrets ----
.env
.env.*
!.env.example

# ---- Data & Models (never commit large/generated artifacts) ----
data/raw/*
data/interim/*
data/processed/*
data/partitions/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/partitions/.gitkeep
!data/README.md

# Phase 4 satellite partition metadata — small, reviewable. The actual
# per-client datasets (data/partitions/SAT-*/train.parquet) stay ignored.
!data/partitions/README.md
!data/partitions/manifest.json
!data/partitions/satellite_metadata.json

results/metrics/*
results/models/*
results/plots/*
results/logs/*
results/reports/*
!results/**/.gitkeep

# Phase 1 dataset analysis deliverables — small, reviewable, worth keeping
# in the repo (unlike bulky experiment logs/metrics/model checkpoints).
!results/plots/dataset/
!results/plots/dataset/*.png
!results/reports/dataset_quality.md

# Phase 2 baseline results deliverables — small, reviewable. The model
# checkpoint itself (results/models/baseline/*.pt) stays ignored (*.pt below).
!results/plots/baseline/
!results/plots/baseline/*.png
!results/reports/baseline_results.md

# Phase 3 temporal results deliverables — small, reviewable. Model
# checkpoints (results/models/temporal/**/*.pt) stay ignored (*.pt below).
!results/plots/temporal/
!results/plots/temporal/*.png
!results/reports/temporal_results.md
!results/reports/sequence_labeling_analysis.md

# Phase 4 satellite simulation deliverables — small, reviewable.
!results/plots/satellite/
!results/plots/satellite/*.png
!results/reports/satellite_simulation_report.md

# Phase 5 local training deliverables — small, reviewable. Per-client
# model checkpoints (results/models/local/SAT-*/best_model.pt) stay
# ignored (*.pt below); per-client metadata.json/training_history.json
# are small and kept.
!results/plots/local_training/
!results/plots/local_training/*.png
!results/plots/local_training/confusion_matrices/
!results/plots/local_training/confusion_matrices/*.png
!results/plots/local_training/training_curves/
!results/plots/local_training/training_curves/*.png
!results/reports/local_training_results.md
!results/models/local/
!results/models/local/*/
!results/models/local/*/metadata.json
!results/models/local/*/training_history.json

# Phase 6 federated learning (FedAvg) deliverables — small, reviewable.
# The global model checkpoint and per-round checkpoints
# (results/models/federated/{best_global_model.pt,round_checkpoints/*.pt})
# stay ignored (*.pt below); round_history.json (round-by-round metrics
# + client contribution log, no model weights) is small and kept.
!results/plots/federated/
!results/plots/federated/*.png
!results/reports/federated_results.md
!results/models/federated/
!results/models/federated/round_history.json

# Phase 7 non-IID FedAvg experiments — small, reviewable. Per-alpha
# generated client parquet partitions stay ignored (large, fully
# reproducible from configs/non_iid.yaml); model checkpoints stay
# ignored (*.pt below); partition_metadata.json/run_config.json/
# round_history.json (all small, no model weights or raw records) are
# kept.
experiments/non_iid/*/partitions/
!results/plots/non_iid/
!results/plots/non_iid/*.png
!results/reports/non_iid_results.md

# Phase 8 rule-based adaptive FL ablation study — small, reviewable.
# Reuses data/partitions/ directly (no per-experiment parquet copies).
# Model checkpoints stay ignored (*.pt below); run_config.json/
# round_history.json (small, no model weights) are kept.
!results/plots/adaptive_fl/
!results/plots/adaptive_fl/*.png
!results/reports/adaptive_fl_results.md

*.ckpt
*.pt
*.pth
*.h5
*.onnx
*.pkl
*.pickle
*.joblib

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/
.claude/

# ---- Logs ----
*.log

# ---- Docker ----
*.pid
